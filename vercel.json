{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/calendly-sync",
      "schedule": "*/5 * * * *"
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/webinario-convite",
      "destination": "/LP1/webinario-convite",
      "permanent": false
    },
    {
      "source": "/webinario-convite/:path*",
      "destination": "/LP1/webinario-convite/:path*",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/shared/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
